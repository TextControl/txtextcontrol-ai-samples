FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props NuGet.Config ./
COPY samples/McpServer/ samples/McpServer/
RUN dotnet publish samples/McpServer/TxTextControl.McpServer.csproj -c Release -r linux-x64 --self-contained false -p:UseAppHost=false -o /out
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 fontconfig \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/ ./
USER app
ENV ASPNETCORE_URLS=https://+:8081
EXPOSE 8081
ENTRYPOINT ["dotnet", "TxTextControl.McpServer.dll"]
