<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>TXTextControl-AI-Samples-Web</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TXTextControl.AI.AspNetCore" />
    <!-- Security baseline also applies when restoring the original beta.1 Knowledge package. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="TXTextControl.TextControl.Core.SDK" />
    <PackageReference Include="TXTextControl.Web" />
    <PackageReference Include="TXTextControl.Web.DocumentEditor.Backend" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="artifacts\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Models\Qwen3-Embedding-0.6B-Q8_0.gguf" />
    <None Include="Models\Qwen_Qwen3.5-4B-Q4_K_M.gguf" />
  </ItemGroup>
</Project>
