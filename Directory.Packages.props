<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Candidate release versions: public feed availability is a release gate. -->
    <PackageVersion Include="TXTextControl.AI" Version="0.1.0-beta.1" />
    <PackageVersion Include="TXTextControl.AI.LlamaServer" Version="0.1.0-beta.1" />
    <PackageVersion Include="TXTextControl.AI.Mcp" Version="0.1.0-beta.1" />
    <PackageVersion Include="TXTextControl.AI.Knowledge" Version="0.1.0-beta.1" />
    <PackageVersion Include="TXTextControl.AI.AspNetCore" Version="0.1.0-beta.1" />
    <PackageVersion Include="TXTextControl.AI.McpServer" Version="0.1.0-beta.1" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <!-- Older beta.1 Knowledge packages do not declare the patched native bundle. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="TXTextControl.TextControl.Core.SDK" Version="34.0.4" />
    <PackageVersion Include="TXTextControl.Web" Version="34.4.0" />
    <PackageVersion Include="TXTextControl.Web.DocumentEditor.Backend" Version="34.4.0" />
  </ItemGroup>
</Project>
